{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "all-g-stockmate",
  "main": "./worker.js",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/feedback",
      "/feedback/"
    ]
  }
}
